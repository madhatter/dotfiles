[global]
    font = BerkeleyMono Nerd Font Mono 12
    format = "%s\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    word_wrap = yes
    ignore_newline = no
    show_age_threshold = 60

    origin = top-right
    offset = (30, 50)
    width = 400
    height = (0, 300)

    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    line_height = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab

    icon_position = left
    max_icon_size = 32
    icon_path = /usr/share/icons/Papirus/32x32/status/:/usr/share/icons/Papirus/32x32/devices/:/usr/share/icons/Papirus/32x32/apps/

    corner_radius = 10

    frame_width = 3
    frame_color = "#af87ff"

    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    background = "#282828cc"
    foreground = "#665c54"
    frame_color = "#3c3836"
    timeout = 10

[urgency_normal]
    background = "#282828cc"
    foreground = "#d5c4a1"
    frame_color = "#af87ff"
    timeout = 10

[urgency_critical]
    background = "#282828cc"
    foreground = "#af87ff"
    frame_color = "#ff0000"
    timeout = 0
