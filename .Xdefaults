##include ".colors/dc2"
#include ".colors/dc1"

## urxvt config
URxvt*termName: rxvt
URxvt*background:  #000000
URxvt*loginShell:  true
URxvt*foreground:  #A8A8A8
URxvt*scrollBar_right:	false
URxvt*scrollstyle:	plain
URxvt*scrollBar:	false
URxvt*borderLess:	false
#URxvt*inheritPixmap:	true
URxvt*geometry:		128x36
URxvt*transparent:	true
URxvt*shading:		30
URxvt*fading:		35
URxvt*saveLines: 12000
#URxvt*font: xft:DejaVuSansM Nerd Font:size=12:style=Regular
URxvt*font: xft:BerkeleyMono Nerd Font Mono:size=12:style=Regular
#xterm*font: xft:SauceCodePro Nerd Font:size=10

## nethack
#NetHack*font:                   vga
NetHack*background:             black
NetHack*foreground:             grey
NetHack*map*background:         black
NetHack*map*black:              grey25
NetHack*map*red:                red3
NetHack*map*green:              green3
NetHack*map*brown:              DarkOrange3
NetHack*map*blue:               blue3
NetHack*map*magenta:            magenta3
NetHack*map*cyan:               cyan3
NetHack*map*gray:               gray70
NetHack*map*orange:             yellow
NetHack*map*bright_green:       green
NetHack*map*yellow:             yellow
NetHack*map*bright_blue:        blue
NetHack*map*bright_magenta:     magenta
NetHack*map*bright_cyan:        cyan
NetHack*map*white:              white

! Set global DPI for Xft (fonts in dwm, dmenu, st, standard toolkits)
! 144 is a good baseline for a 32-inch 4K display (1.5x scaling)
Xft.dpi: 144

! Enable anti-aliasing
Xft.antialias: 1

! Set hinting style (slight is usually best for high density displays)
Xft.hinting: 1
Xft.hintstyle: hintslight

! Subpixel rendering geometry
Xft.rgba: rgb

! Set cursor size (if supported by the cursor theme)
Xcursor.size: 24
