# --- Movement ---
def_key "j"
  scroll_down
def_key "k"
  scroll_up
def_key "h"
  previous_column
def_key "l"
  next_column

# --- Search ---
def_key "/"
  find
def_key "n"
  next_found_item
def_key "N"
  previous_found_item

# --- Views ---
def_key "L"
  show_lyrics

# --- Seeking ---
def_key "right"
  seek_forward
def_key "left"
  seek_backward
