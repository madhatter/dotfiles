# Cloned at runtime by install-tmux-plugins into the stowed tmux package
tmux/.config/tmux/plugins/

# Runtime files created by the applications themselves
ncmpcpp/.config/ncmpcpp/error.log
tin/.tin/newsrctable

# Karabiner writes backups next to its config
karabiner/.config/karabiner/automatic_backups/

# Work identity, kept local only
git/.gitconfig-work

# opencode runtime files written into its config dir
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package.json
opencode/.config/opencode/bun.lock

# Private, host-local instructions (loaded via "instructions" in opencode.json)
opencode/.config/opencode/AGENTS.local.md
