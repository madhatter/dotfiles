{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto"
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "format": "{2}"
    },
    {
      "type": "terminalFont",
      "key": "Font"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{2}"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{1} ({3}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{1} {2}"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{1} / {2} ({3})",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    }
  ]
}
