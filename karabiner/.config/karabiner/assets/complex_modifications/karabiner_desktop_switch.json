{
  "title": "Desktop Switching with Cmd+Number",
  "rules": [
    {
      "description": "Switch to Desktop 1 with Cmd+1",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": ["command"]
            }
          },
          "to": [
            {
              "shell_command": "osascript -e 'tell application \"System Events\" to keystroke \"1\" using {control down, command down}'"
            }
          ]
        }
      ]
    },
