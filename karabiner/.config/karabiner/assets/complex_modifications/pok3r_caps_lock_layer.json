{
  "title": "Pok3r Caps Lock Layer",
  "rules": [
    {
      "description": "Pok3r Caps Lock Layer: hjkl → arrow keys",
      "manipulators": [
        {
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "set_variable": {
                "name": "caps_layer",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "caps_layer",
                "value": 0
              }
            }
          ],
          "type": "basic"
        },
        {
          "type": "basic",
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ],
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["left_shift"] }
          },
          "to": [{ "key_code": "left_arrow", "modifiers": ["left_shift"] }]
        },
        {
          "conditions": [
            {
              "name": "caps_layer",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "h" },
          "to": [{ "key_code": "left_arrow" }],
          "type": "basic"
        },
        {
          "type": "basic",
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ],
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["left_shift"] }
          },
          "to": [{ "key_code": "down_arrow", "modifiers": ["left_shift"] }]
        },
        {
          "conditions": [
            {
              "name": "caps_layer",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "j" },
          "to": [{ "key_code": "down_arrow" }],
          "type": "basic"
        },
        {
          "type": "basic",
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ],
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["left_shift"] }
          },
          "to": [{ "key_code": "up_arrow", "modifiers": ["left_shift"] }]
        },
        {
          "conditions": [
            {
              "name": "caps_layer",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "k" },
          "to": [{ "key_code": "up_arrow" }],
          "type": "basic"
        },
        {
          "type": "basic",
          "conditions": [
            { "type": "variable_if", "name": "caps_layer", "value": 1 }
          ],
          "from": {
            "key_code": "l",
            "modifiers": { "mandatory": ["left_shift"] }
          },
          "to": [{ "key_code": "right_arrow", "modifiers": ["left_shift"] }]
        },
        {
          "conditions": [
            {
              "name": "caps_layer",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "l" },
          "to": [{ "key_code": "right_arrow" }],
          "type": "basic"
        }
      ]
    }
  ]
}
