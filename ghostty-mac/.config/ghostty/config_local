font-size = 15

# Use non-native fullscreen on macOS but show the menu bar because of the notch.
fullscreen = non-native-visible-menu
# Disable macOS window shadow to have a more fullscreen look
macos-window-shadow = false

background = #161617
foreground = #c9c7cd

# darker than bg so p10k dir/github segments stay visible
palette = 0=#27272a

macos-option-as-alt = left

keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+l=text:l
keybind = ctrl+semicolon=text:\x1bOP

# tmux window switching
keybind = super+one=text:\x1b1
keybind = super+two=text:\x1b2
keybind = super+three=text:\x1b3
keybind = super+four=text:\x1b4
keybind = super+five=text:\x1b5
keybind = super+six=text:\x1b6
keybind = super+seven=text:\x1b7
keybind = super+eight=text:\x1b8
keybind = super+nine=text:\x1b9
