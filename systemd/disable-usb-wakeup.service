[Unit]
Description=Disable USB controller wakeups to prevent suspend loops
DefaultDependencies=no

[Service]
Type=oneshot
# Toggle off wakeup for every XHC* device (XHC/XHCI) that has it enabled.
# Note: $$ is required so systemd passes a literal $ to the shell.
ExecStart=/bin/sh -c "awk '$$1 ~ /^XHC/ && $$3 == \"*enabled\" {print $$1}' /proc/acpi/wakeup | while read -r d; do echo \"$$d\" > /proc/acpi/wakeup; done"

[Install]
WantedBy=multi-user.target
